# ─────────────────────────────────────────────────────────────────────────────
# MERCO – Catalogue SaaS automatisé (Next.js + Nhost + Envato Market API)
# Copier ce fichier vers `.env.local` puis renseigner les valeurs.
# Ne commiter JAMAIS `.env.local` ni les vraies valeurs de secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── Public (exposé au navigateur) ─────────────────────────────────────────────
# Conçus pour être inclus (préfixe NEXT_PUBLIC_) dans le bundle client.
NEXT_PUBLIC_SITE_URL=https://landinpagesaas.vercel.app
NEXT_PUBLIC_NHOST_SUBDOMAIN=
NEXT_PUBLIC_NHOST_REGION=

# Analytics / Ads (déjà utilisés par lib/constants.ts)
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-18256411556

# ── Serveur uniquement (NE JAMAIS ajouter NEXT_PUBLIC_ NI importer côté client) ──
# Admin Nhost. Permet à la base d'écrire via Hasura (routes serveur uniquement).
NHOST_ADMIN_SECRET=

# Personal Token Envato Market (serveur uniquement). Accès aux données publiques.
# https://build.envato.com/ → votre compte → Personal Tokens.
ENVATO_API_TOKEN=

# Secret partagé du cron Vercel qui appelle GET /api/catalog/sync
# (voir vercel.json). Le cron envoie :  Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Secret partagé pour les déclenchements de synchronisation manuels depuis l'admin
# (Authorization: Bearer <CATALOG_SYNC_SECRET>).
CATALOG_SYNC_SECRET=